# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# ==== Required ====
# Supabase project URL + anon key. Find these in your Supabase
# project > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ==== Optional: AI features (invoice generation, email drafts) ====
# Without this, the app falls back to template-based generation.
OPENAI_API_KEY=sk-proj-your-key

# ==== Optional: Email sending ====
# Without RESEND_API_KEY, invoices are saved but no email is sent.
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=invoices@yourdomain.com

# ==== Optional: used in email footers / links ====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==== Optional: admin operations (not currently used, reserved) ====
SUPABASE_SERVICE_ROLE_KEY=
